<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.report.theme</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <form position="inside">
                <app string="Report Themes" name="report_theme_manager">
                    <setting string="Active Theme" help="Select the default branding theme for all PDF reports in this company.">
                        <field name="active_theme_id"
                               domain="[('company_id', '=', allowed_company_ids[0])]"
                               options="{'no_create': True}"/>
                    </setting>
                    <setting string="Manage Themes" help="Create, edit or delete theme profiles for your company reports.">
                        <button
                            name="action_open_report_themes"
                            type="object"
                            string="Open Theme Profiles"
                            class="btn btn-secondary"/>
                    </setting>
                </app>
            </form>

        </field>
    </record>

</odoo>