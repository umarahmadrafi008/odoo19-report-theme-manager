<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sale_order_inherit_theme"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-set="theme" t-value="o.company_id.active_theme_id"/>
            <t t-if="theme and theme.apply_to_sale">
                <style t-attf-type="text/css">
                    body { font-family: '<t t-esc="theme.is_rtl and theme.rtl_font or theme.font_family"/>', sans-serif; font-size: <t t-esc="theme.font_size_body"/>pt; direction: <t t-esc="'rtl' if theme.is_rtl else 'ltr'"/>; }
                    h2, h3, strong { color: <t t-esc="theme.primary_color"/>; }
                    thead th { background-color: <t t-esc="theme.primary_color"/> !important; color: #fff !important; }
                    tbody tr:nth-child(even) td { background-color: <t t-esc="theme.secondary_color"/>; }
                    <t t-if="theme.show_watermark and theme.watermark_text">
                    .o_watermark { position: fixed; top: 40%; left: 50%; transform: translate(-50%,-50%) rotate(-35deg); font-size: 80pt; font-weight: bold; color: rgba(0,0,0,<t t-esc="theme.watermark_opacity"/>); pointer-events: none; z-index: 9999; white-space: nowrap; }
                    </t>
                </style>
                <t t-if="theme.show_watermark and theme.watermark_text">
                    <div class="o_watermark"><t t-esc="theme.watermark_text"/></div>
                </t>
                <t t-if="theme.show_header and theme.header_text">
                    <div t-att-style="'background-color:' + theme.primary_color + ';color:#fff;padding:8px 16px;margin-bottom:8px;'">
                        <t t-out="theme.header_text"/>
                    </div>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="after">
            <t t-set="theme" t-value="o.company_id.active_theme_id"/>
            <t t-if="theme and theme.apply_to_sale and theme.show_footer and theme.footer_text">
                <div t-att-style="'border-top:2px solid ' + theme.primary_color + ';padding:6px 16px;font-size:8pt;color:#666;'">
                    <t t-out="theme.footer_text"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>